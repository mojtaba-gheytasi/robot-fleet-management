# Copy to .env to change any of these. Docker Compose reads .env on its own.

# Database and host ports used by Docker Compose.
POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet_dev_password
POSTGRES_PORT=5432
HTTP_PORT=8080

# Service settings for running it on the host (go run ./cmd/fleet).
# Inside Compose the service gets its own values from docker-compose.yml.
DATABASE_URL=postgres://fleet:fleet_dev_password@127.0.0.1:5432/fleet?sslmode=disable
HTTP_SERVER_ADDRESS=127.0.0.1:8080
ALERT_CHECK_INTERVAL=5s
